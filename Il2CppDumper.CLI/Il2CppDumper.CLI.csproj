<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<AssemblyName>Il2CppDumper</AssemblyName>
		<RootNamespace>Il2CppDumper</RootNamespace>
		<DebugType>embedded</DebugType>
		<!-- COM file dialogs shown when the exe is started without arguments on Windows -->
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationIcon>..\Assets\il2cppdumper.ico</ApplicationIcon>
		<Description>Command-line version of Il2CppDumper GUI by AndnixSH. This is the fork of Il2CppDumper by Perfare</Description>
		<Copyright>Copyright © AndnixSH 2024 | Original project: Perfare 2016-2024</Copyright>
		<Title>Il2CppDumper CLI</Title>
		<Authors>AndnixSH, Perfare</Authors>
		<Product>Il2CppDumper</Product>
		<PackageProjectUrl>https://github.com/AndnixSH/Il2CppDumper</PackageProjectUrl>
		<RepositoryUrl>https://github.com/AndnixSH/Il2CppDumper</RepositoryUrl>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Il2CppDumper.Core\Il2CppDumper.Core.csproj" />
	</ItemGroup>
</Project>
